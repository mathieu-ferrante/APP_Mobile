# Modele de configuration de signature release.
#
# 1. Genere ton keystore (choisis TOI-MEME les mots de passe) :
#
#      keytool -genkeypair -v -keystore phoenix-release.jks \
#        -alias phoenix -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copie ce fichier en "keystore.properties" et renseigne les valeurs.
# 3. Sauvegarde le .jks ET les mots de passe hors du projet : sans eux,
#    tu ne pourras plus jamais publier de mise a jour de l'application.
#
# "keystore.properties" et "*.jks" sont dans .gitignore : ils ne partiront
# jamais dans Git. Sans "keystore.properties", le build release reste
# simplement non signe et tout continue de fonctionner.

storeFile=phoenix-release.jks
storePassword=
keyAlias=phoenix
keyPassword=
